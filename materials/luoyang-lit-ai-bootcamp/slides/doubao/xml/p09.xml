    </shape>
    <shape type="text" topLeftX="70" topLeftY="224" width="366" height="26">
      <content textType="body" fontSize="18" fontFamily="寒蝉端黑体" color="rgb(241,226,194)" wrap="false">
        <p>生产端 · Outbox 本地消息表</p>
      </content>
    </shape>
    <line startX="70" startY="262" endX="150" endY="262">
