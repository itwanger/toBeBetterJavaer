    },
    {
      "startFrame": 282,
      "endFrame": 315,
      "text": "“让我们一步步思考”，",
      "beatId": 10
    },
    {
      "startFrame": 315,
      "endFrame": 371,
      "text": "引导模型输出推导步骤。",
      "beatId": 10
    },
    {
      "startFrame": 371,
      "endFrame": 390,
      "text": "这样的话，",
      "beatId": 10
    },
    {
      "startFrame": 390,
      "endFrame": 459,
      "text": "推导步骤和最终答案就混在一起。",
      "beatId": 10
    },
    {
      "startFrame": 459,
      "endFrame": 524,
      "text": "现在的 DeepSeek 在后训练阶段",
