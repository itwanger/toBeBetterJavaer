    },
    {
      "startFrame": 587,
      "endFrame": 642,
      "text": "就会先提出假设、再验算，",
      "beatId": 10
    },
    {
      "startFrame": 642,
      "endFrame": 703,
      "text": "发现思路走不通就推翻重来。",
      "beatId": 10
    },
    {
      "startFrame": 703,
      "endFrame": 773,
      "text": "从 DeepSeek Harness 的源码可以看到，",
