  "subtitles": [
    {
      "startFrame": 0,
      "endFrame": 48,
      "text": "那聪明的你一定会问，",
      "beatId": 7
    },
    {
      "startFrame": 48,
      "endFrame": 122,
      "text": "DSH 依赖 Node.js 和 Linux 环境，",
      "beatId": 7
    },
    {
      "startFrame": 122,
      "endFrame": 152,
      "text": "手机怎么跑起来？",
      "beatId": 7
    },
    {
      "startFrame": 152,
      "endFrame": 229,
      "text": "普通 App 直接调用系统命令时，",
      "beatId": 8
    },
    {
      "startFrame": 229,
      "endFrame": 280,
      "text": "会被 Android 的权限拦下来。",
      "beatId": 8
    },
    {
      "startFrame": 280,
      "endFrame": 364,
      "text": "DSH Go 的做法是把 Ubuntu、Node.js、",
      "beatId": 9
    },
    {
      "startFrame": 364,
      "endFrame": 417,
      "text": "Python、pnpm 和 DSH",
      "beatId": 9
    },
    {
      "startFrame": 417,
      "endFrame": 472,
      "text": " 一起打包成一套内置的运行环境。",
      "beatId": 9
    },
    {
      "startFrame": 472,
      "endFrame": 542,
      "text": "默认是以 PRoot 模式兼容启动。",
      "beatId": 10
    },
    {
      "startFrame": 542,
      "endFrame": 600,
      "text": "PRoot 是一个运行在用户态的工具，",
      "beatId": 10
    },
    {
      "startFrame": 600,
      "endFrame": 667,
      "text": "它会拦截访问文件的系统调用，",
      "beatId": 11
    },
    {
      "startFrame": 667,
      "endFrame": 734,
      "text": "把路径改写到 App 自己的私有目录里，",
      "beatId": 11
    },
    {
      "startFrame": 734,
      "endFrame": 773,
      "text": "所以不需要 Root 权限",
      "beatId": 11
    },
    {
      "startFrame": 773,
      "endFrame": 824,
      "text": "也能运行完整的 Linux 环境。",
      "beatId": 11
    },
    {
      "startFrame": 824,
      "endFrame": 906,
      "text": "不过，由于这种方式需要在系统调用时",
      "beatId": 12
    },
    {
      "startFrame": 906,
      "endFrame": 956,
      "text": "做一次路径转换，速度偏慢。",
      "beatId": 12
    },
    {
      "startFrame": 956,
      "endFrame": 992,
      "text": "如果你嫌慢的话，",
      "beatId": 13
    },
    {
      "startFrame": 992,
      "endFrame": 1062,
      "text": "可以在开发者选项里打开直接启动，",
      "beatId": 13
    },
    {
      "startFrame": 1062,
      "endFrame": 1107,
      "text": "改由 Node 的预加载模块",
      "beatId": 13
    },
    {
      "startFrame": 1107,
      "endFrame": 1168,
      "text": "负责路径映射和 DNS 解析。",
      "beatId": 13
    },
    {
      "startFrame": 1168,
      "endFrame": 1257,
      "text": "如果直接启动被 Android 的系统限制拦截，",
      "beatId": 14
    },
    {
      "startFrame": 1257,
      "endFrame": 1320,
      "text": "DSH Go 会自动退回兼容启动。",
      "beatId": 14
    },
    {
      "startFrame": 1320,
      "endFrame": 1421,
      "text": "这套本机环境大约要占用 1 GB 存储空间。",
      "beatId": 15
    },
    {
      "startFrame": 1421,
      "endFrame": 1495,
      "text": "需要注意，手机上运行的只是 Agent 引擎，",
      "beatId": 15
    },
    {
      "startFrame": 1495,
      "endFrame": 1563,
      "text": "大模型推理仍然需要联网。",
      "beatId": 16
    },
    {
      "startFrame": 1563,
      "endFrame": 1618,
      "text": "如果手机剩余空间不足，",
      "beatId": 17
    },
    {
      "startFrame": 1618,
      "endFrame": 1693,
      "text": "可以在安装后直接选择远程主机，",
      "beatId": 17
    },
    {
      "startFrame": 1693,
      "endFrame": 1765,
      "text": "通过 SSH 隧道或端到端加密的",
      "beatId": 17
    },
    {
      "startFrame": 1765,
      "endFrame": 1816,
      "text": " DSH Remote 连接电脑。",
      "beatId": 17
    },
    {
      "startFrame": 1816,
      "endFrame": 1907,
      "text": "DSH Remote 会优先尝试局域网直连",
      "beatId": 18
    },
    {
      "startFrame": 1907,
      "endFrame": 1943,
      "text": "或 P2P 直连，",
      "beatId": 18
    },
    {
      "startFrame": 1943,
      "endFrame": 1991,
      "text": "连不上再走中继服务器。",
      "beatId": 18
    },
    {
      "startFrame": 1991,
      "endFrame": 2058,
      "text": "你还可以打开“精简历史”开关，",
      "beatId": 19
    },
    {
      "startFrame": 2058,
      "endFrame": 2154,
      "text": "让电脑先把早期工具调用的参数和长输出",
      "beatId": 19
    },
    {
      "startFrame": 2154,
      "endFrame": 2220,
      "text": "压缩成简短摘要，再传给手机，",
      "beatId": 19
    },
    {
      "startFrame": 2220,
      "endFrame": 2305,
      "text": "这样上下文不会中断，也能节省流量。",
      "beatId": 20
    },
    {
      "startFrame": 2305,
      "endFrame": 2348,
      "text": "恭喜看到这里的你，",
      "beatId": 21
    },
    {
      "startFrame": 2348,
      "endFrame": 2426,
      "text": "已经成功击败 50% 的学习者了。",
      "beatId": 21
    }
