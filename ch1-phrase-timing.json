  "subtitles": [
    {
      "startFrame": 0,
      "endFrame": 89,
      "text": "把挂在弹簧测力计下的金属块放进水里，",
      "beatId": 1
    },
    {
      "startFrame": 89,
      "endFrame": 133,
      "text": "测力计的示数会变小。",
      "beatId": 1
    },
    {
      "startFrame": 133,
      "endFrame": 181,
      "text": "金属块的重力没有变，",
      "beatId": 2
    },
    {
      "startFrame": 181,
      "endFrame": 236,
      "text": "是水给了金属块一个向上托的力，",
      "beatId": 2
    },
    {
      "startFrame": 236,
      "endFrame": 265,
      "text": "这个力叫浮力。",
      "beatId": 2
    },
    {
      "startFrame": 265,
      "endFrame": 313,
      "text": "阿基米德原理说的是：",
      "beatId": 3
    },
    {
      "startFrame": 313,
      "endFrame": 380,
      "text": "浸在液体中的物体受到向上的浮力，",
      "beatId": 3
    },
    {
      "startFrame": 380,
      "endFrame": 477,
      "text": "浮力的大小等于物体排开的液体所受的重力。",
      "beatId": 3
    },
    {
      "startFrame": 477,
      "endFrame": 511,
      "text": "“排开”指的是，",
      "beatId": 4
    },
    {
      "startFrame": 511,
      "endFrame": 587,
      "text": "物体浸在液体里的部分占据多大体积，",
      "beatId": 4
    },
    {
      "startFrame": 587,
      "endFrame": 645,
      "text": "就有多大体积的液体让出位置。",
      "beatId": 4
    },
    {
      "startFrame": 645,
      "endFrame": 698,
      "text": "把浮力记作 F 浮，",
      "beatId": 5
    },
    {
      "startFrame": 698,
      "endFrame": 763,
      "text": "排开液体所受的重力记作 G 排，",
      "beatId": 5
    },
    {
      "startFrame": 763,
      "endFrame": 814,
      "text": "公式就是 F 浮等于 G 排。",
      "beatId": 5
    },
    {
      "startFrame": 814,
      "endFrame": 900,
      "text": "下面用一组示例数值来做说明。",
      "beatId": 6
    },
    {
      "startFrame": 900,
      "endFrame": 1004,
      "text": "假设金属块的体积是 2 立方分米，也就是 2 升，",
      "beatId": 6
    },
    {
      "startFrame": 1004,
      "endFrame": 1079,
      "text": "全部浸没在水中，就会排开 2 升水。",
      "beatId": 6
    },
    {
      "startFrame": 1079,
      "endFrame": 1141,
      "text": "2 升水的质量是 2 千克，",
      "beatId": 7
    },
    {
      "startFrame": 1141,
      "endFrame": 1233,
      "text": "每千克按 10 牛的重力算，这些水重 20 牛顿，",
      "beatId": 7
    },
    {
      "startFrame": 1233,
      "endFrame": 1279,
      "text": "所以浮力也是 20 牛顿。",
      "beatId": 7
    },
    {
      "startFrame": 1279,
      "endFrame": 1339,
      "text": "如果只有一半体积浸在水里，",
      "beatId": 8
    },
    {
      "startFrame": 1339,
      "endFrame": 1407,
      "text": "排开 1 升水，浮力就是 10 牛顿。",
      "beatId": 8
    },
    {
      "startFrame": 1407,
      "endFrame": 1503,
      "text": "为什么浮力等于排开的液体所受的重力？",
      "beatId": 9
    },
    {
      "startFrame": 1503,
      "endFrame": 1553,
      "text": "先看浮力从哪里来。",
      "beatId": 9
    },
    {
      "startFrame": 1553,
      "endFrame": 1600,
      "text": "水越深，压强越大。",
      "beatId": 9
    },
    {
      "startFrame": 1600,
      "endFrame": 1660,
      "text": "金属块底部比顶部深，",
      "beatId": 10
    },
    {
      "startFrame": 1660,
      "endFrame": 1754,
      "text": "底部受到的向上压力大于顶部受到的向下压力，",
      "beatId": 10
    },
    {
      "startFrame": 1754,
      "endFrame": 1818,
      "text": "侧面受到的水平压力左右抵消，",
      "beatId": 10
    },
    {
      "startFrame": 1818,
      "endFrame": 1896,
      "text": "所以压力的合力向上，这个合力就是浮力。",
      "beatId": 10
    },
    {
      "startFrame": 1896,
      "endFrame": 1946,
      "text": "换个角度想。",
      "beatId": 11
    },
    {
      "startFrame": 1946,
      "endFrame": 2024,
      "text": "金属块入水前，这个位置原本就是水。",
      "beatId": 11
    },
    {
      "startFrame": 2024,
      "endFrame": 2077,
      "text": "周围水能托住这部分水，",
      "beatId": 12
    },
    {
      "startFrame": 2077,
      "endFrame": 2122,
      "text": "让这部分水保持静止，",
      "beatId": 12
    },
    {
      "startFrame": 2122,
      "endFrame": 2199,
      "text": "说明向上的托力正好等于这部分水的重力。",
      "beatId": 12
    },
    {
      "startFrame": 2199,
      "endFrame": 2290,
      "text": "现在，金属块只是接替了这部分水的位置，",
      "beatId": 13
    },
    {
      "startFrame": 2290,
      "endFrame": 2343,
      "text": "周围水的压力分布没有改变，",
      "beatId": 13
    },
    {
      "startFrame": 2343,
      "endFrame": 2398,
      "text": "金属块受到的浮力大小也不变，",
      "beatId": 13
    },
    {
      "startFrame": 2398,
      "endFrame": 2470,
      "text": "所以浮力就等于金属块排开水的重力。",
      "beatId": 13
    },
    {
      "startFrame": 2470,
      "endFrame": 2590,
      "text": "这个原理对全部或部分浸入的物体都适用，包括气体。",
      "beatId": 14
    },
    {
      "startFrame": 2590,
      "endFrame": 2667,
      "text": "知道排开流体的体积，就能求出浮力，",
      "beatId": 14
    },
    {
      "startFrame": 2667,
      "endFrame": 2767,
      "text": "进一步分析出物体是在漂浮、悬浮还是下沉。",
      "beatId": 14
    }
  ],
